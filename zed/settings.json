// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "when_closing_with_no_tabs": "close_window",
  "git": {
    "inline_blame": {
      "enabled": false
    },
    "disable_git": true
  },
  "project_panel": {
    "drag_and_drop": false,
    "auto_fold_dirs": false,
    "auto_reveal_entries": false
  },
  "preview_tabs": {
    "enable_preview_file_from_code_navigation": false,
    "enable_preview_from_multibuffer": false,
    "enable_preview_from_project_panel": false,
    "enabled": false
  },
  "tabs": {
    "activate_on_close": "left_neighbour"
  },
  "tab_bar": {
    "show_nav_history_buttons": false
  },
  "terminal": {
    "button": false
  },
  "search": {
    "regex": true,
    "case_sensitive": true
  },
  "languages": {
    "C++": {
      "tab_size": 2
    }
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "document_symbols": "on",
  "document_folding_ranges": "on",
  "semantic_tokens": "combined",
  "modeline_lines": 3,
  "jsx_tag_auto_close": {
    "enabled": false
  },
  "use_auto_surround": false,
  "use_autoclose": false,
  "use_on_type_format": false,
  "ensure_final_newline_on_save": false,
  "format_on_save": "off",
  "preferred_line_length": 120,
  "scrollbar": {
    "show": "system"
  },
  "auto_update": false,
  "buffer_font_family": "Envy Code R",
  "buffer_font_fallbacks": [".ZedMono"],
  "buffer_font_features": {
    // Ligatures
    "calt": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "base_keymap": "JetBrains",
  "icon_theme": "Zed (Default)",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "restore_on_startup": "empty_tab",
  "on_last_window_closed": "quit_app",
  "window_decorations": "server",
  "use_system_path_prompts": false,
  "current_line_highlight": "gutter",
  "theme": {
    "mode": "dark",
    "light": "Neon Light",
    "dark": "Neon Dark",
  },
}
